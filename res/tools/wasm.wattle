; Build predoc as a web program and publish it to pages. Run from anywhere
; with `wattle res/tools/wasm.wattle`. This needs Zig and the Wattle package, as
; `wattle build web` does.

(import ../../lib/util)

(def- s util/sep)

(defn- path
  [& parts]
  (string/join s parts))

(defn- run
  [args message]
  (def [ok? result] (protect (os/execute args :px)))
  (unless ok?
    (error (string message ": " result)))
  (unless (zero? result)
    (error (string message " (exit status " result ")"))))

(defn- run-output
  [args message]
  (def proc (os/spawn args :p {:out :pipe}))
  (def output (:read (proc :out) :all))
  (os/proc-wait proc)
  (unless (zero? (proc :return-code))
    (error message))
  (string/trim output))

(defn- replace-ref
  [html fingerprint]
  (def prefix "src=\"dingus.js?")
  (def begin (string/find prefix html))
  (unless begin
    (error "dingus.js cache reference is missing"))
  (def end (string/find "\"" html (+ begin (length prefix))))
  (string (string/slice html 0 (+ begin (length prefix)))
          fingerprint
          (string/slice html end)))

(defn- clear
  [dir]
  (when (os/stat dir)
    (each name (os/dir dir)
      (os/rm (path dir name)))))

(defn main
  "Builds the web program into pages/predoc and points pages/index.html at it."
  [script & args]
  (def threeup (comp util/parent util/parent util/parent))
  (def root (-> (dyn :current-file) util/abspath threeup))
  (os/cd root)
  (def built (path root "zig-out" "web" "dingus"))
  ; The build adds files named by their hash and removes none, so clear first.
  (clear built)
  (print "Building web program...")
  (run [(dyn :executable) "build" "web" "dingus"]
       "cannot build the web program")
  (def published (path root "pages" "predoc"))
  (unless (os/stat published)
    (os/mkdir published))
  ; The names carry a hash of the build, so a rebuild replaces every file.
  (clear published)
  (each name (os/dir built)
    (spit (path published name) (slurp (path built name))))
  (def loader (path published "dingus.js"))
  (def fingerprint
    (string/slice (run-output ["git" "hash-object" loader]
                              "cannot hash dingus.js")
                  0 12))
  (def html-file (path root "pages" "index.html"))
  (spit html-file (replace-ref (slurp html-file) fingerprint))
  (print "published pages/predoc (" fingerprint ")"))
